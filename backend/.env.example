# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Database Configuration
# Defaults to SQLite for instant local development out-of-the-box.
# Switch to PostgreSQL when ready:
DATABASE_URL=sqlite:///./inq.db

# PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inq_db
